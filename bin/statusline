#!/usr/bin/env bash
# statusline: how much Claude is left — plan windows, context, model — in one line.
# Fed the session JSON on stdin by Claude Code (settings.json -> statusLine).
set -uo pipefail

# Four colours, lowest band first. The default is daltonised: blue → cyan →
# yellow → magenta, deliberately with no red/green axis. A machine that reads
# colour differently names its own four in statusline.conf, and both ramps
# draw from them — one palette, two sets of thresholds.
#
# Resolved before the session is read, because none of it depends on one —
# which is what lets --explain answer without being fed anything.
RAMP=(34 36 33 35)

colour_code() {
  case "$1" in
    black) printf 30 ;; red)     printf 31 ;; green) printf 32 ;; yellow) printf 33 ;;
    blue)  printf 34 ;; magenta) printf 35 ;; cyan)  printf 36 ;; white)  printf 37 ;;
    *) return 1 ;;
  esac
}

SEGMENTS='5h 7d ctx turns model where'
conf="$HOME/.claude/statusline.conf"
directive() { sed 's/#.*//' "$conf" | awk -v k="$1" '$1 == k { $1 = ""; sub(/^ +/, ""); print; exit }'; }
IGNORED=''

if [ -r "$conf" ]; then
  configured=$(directive segments)
  [ -n "$configured" ] && SEGMENTS="$configured"

  # Four names or none: a ramp that cannot be read in full leaves the default
  # standing, so a typo shows up as nothing changing rather than as one band
  # quietly painted the wrong colour. What was ignored is remembered, because
  # falling back in silence is exactly what --explain exists to break.
  configured=$(directive ramp)
  if [ -n "$configured" ]; then
    read -r -a names <<<"$configured"
    codes=()
    for n in "${names[@]}"; do c=$(colour_code "$n") && codes+=("$c"); done
    if [ "${#names[@]}" -eq 4 ] && [ "${#codes[@]}" -eq 4 ]; then
      RAMP=("${codes[@]}")
    else
      IGNORED='ramp'
    fi
  fi
fi

# What this machine's statusline will do, for anything that would otherwise
# have to parse statusline.conf a second time and drift from this.
if [ "${1:-}" = --explain ]; then
  printf 'config %s\n'   "$conf"
  printf 'segments %s\n' "$SEGMENTS"
  printf 'ramp %s\n'     "${RAMP[*]}"
  [ -n "$IGNORED" ] && printf 'ignored %s\n' "$IGNORED"
  exit 0
fi

input=$(cat)

IFS=$'\t' read -r fh_pct fh_reset sd_pct sd_reset ctx model effort thinking dir branch pr transcript <<<"$(
  printf '%s' "$input" | jq -r '
    [ (.rate_limits.five_hour.used_percentage // "-"),
      (.rate_limits.five_hour.resets_at       // "-"),
      (.rate_limits.seven_day.used_percentage // "-"),
      (.rate_limits.seven_day.resets_at       // "-"),
      (.context_window.used_percentage        // "-"),
      (.model.display_name // "-" | sub(" +\\(.*\\)$"; "")),
      (.effort.level                          // "-"),
      (if .thinking.enabled then "think" else "-" end),
      (.workspace.git_worktree // (.workspace.current_dir // "/-" | split("/") | last)),
      "-",
      (.pr.number // "-"),
      (.transcript_path // "-")
    ] | @tsv' 2>/dev/null
)"

# A schema change that breaks the jq pass must not paint a garbage line.
[ -z "${model:-}" ] && exit 0

DIM=$'\033[2m'; RESET=$'\033[0m'

# Which of the four bands a value falls in. A value that is not a number sinks
# to the lowest band rather than colouring the line by accident.
band() { # value low mid high
  if   [ "$1" -ge "$4" ] 2>/dev/null; then printf 3
  elif [ "$1" -ge "$3" ] 2>/dev/null; then printf 2
  elif [ "$1" -ge "$2" ] 2>/dev/null; then printf 1
  else printf 0; fi
}

hue() { printf '\033[%sm' "${RAMP[$(band "${1%%.*}" 40 70 90)]}"; }

# 5-cell bar so the number has a shape next to it.
bar() {
  local p=${1%%.*} i filled out=""
  filled=$(( (p * 5 + 99) / 100 ))
  for ((i = 0; i < 5; i++)); do
    if [ "$i" -lt "$filled" ]; then out+="▰"; else out+="▱"; fi
  done
  printf '%s' "$out"
}

# Seconds until reset -> 2h07 / 3d1h / 12m.
until_reset() {
  local now s d h m
  now=$(date +%s); s=$(( $1 - now ))
  [ "$s" -le 0 ] && { printf 'now'; return; }
  d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
  if   [ "$d" -gt 0 ]; then printf '%dd%dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf '%dh%02d' "$h" "$m"
  else printf '%dm' "$m"; fi
}

window() { # label pct resets_at
  [ "$2" = "-" ] && return
  local p=${2%%.*} c; c=$(hue "$p")
  printf '%s%s%s %s%s %s%%%s' "$DIM" "$1" "$RESET" "$c" "$(bar "$p")" "$p" "$RESET"
  [ "$3" != "-" ] && printf ' %s⟳%s%s' "$DIM" "$(until_reset "$3")" "$RESET"
}

# Seconds -> 45s / 2m14 / 1h05.
fmt_dur() {
  local s=$1
  if   [ "$s" -ge 3600 ]; then printf '%dh%02d' $(( s / 3600 )) $(( s % 3600 / 60 ))
  elif [ "$s" -ge 60 ]; then printf '%dm%02d' $(( s / 60 )) $(( s % 60 ))
  else printf '%ds' "$s"; fi
}

# The same four colours, banded by 1m / 3m / 10m instead.
dur_hue() { printf '\033[%sm' "${RAMP[$(band "$1" 60 180 600)]}"; }

# Per-turn wall clock off the transcript: prompt -> last assistant message of the
# same turn, so it stops growing once the turn ends and never counts idle time.
# Prints "<last> <mean>" in seconds. Cached on transcript size.
turn_times() {
  local f=$1 cache cf size csize turns
  [ -r "$f" ] || return
  size=$(stat -c %s "$f" 2>/dev/null) || return
  cache="${TMPDIR:-/tmp}/claude-statusline-$(id -u)"
  cf="$cache/${f##*/}.turns"
  if [ -r "$cf" ] && read -r csize turns < "$cf" && [ "$csize" = "$size" ]; then
    printf '%s' "$turns"; return
  fi
  turns=$(jq -r '
      select(.isSidechain != true)
      | select(.type == "user" or .type == "assistant")
      | [ .type,
          (.promptId // "-"),
          (if .toolUseResult then 1 else 0 end),
          ((.timestamp // "") | sub("\\.[0-9]+Z$"; "Z")
             | if . == "" then 0 else fromdateiso8601 end) ]
      | @tsv' "$f" 2>/dev/null |
    awk -F'\t' '
      function close_turn() {
        if (cur != "" && last_a > start) { d = last_a - start; n++; sum += d; last = d }
      }
      $1 == "user" && $3 == 0 && $2 != "-" && $2 != cur { close_turn(); cur = $2; start = $4; last_a = 0 }
      $1 == "assistant" { last_a = $4 }
      END { close_turn(); if (n > 0) printf "%d %d\n", last, sum / n }')
  [ -z "$turns" ] && return
  mkdir -p "$cache" && printf '%s %s\n' "$size" "$turns" > "$cf"
  printf '%s' "$turns"
}

# Which segments the line carries is a per-machine preference, so it comes
# from an untracked ~/.claude/statusline.conf rather than the tracked checkout,
# and the order they are named in is the order they are drawn. No file, or a
# directive naming nothing, keeps the line as it has always been — a blank
# statusline is indistinguishable from a broken one.

seg=()
for name in $SEGMENTS; do
  case "$name" in
    5h) w=$(window 5h "$fh_pct" "$fh_reset"); [ -n "$w" ] && seg+=("$w") ;;
    7d) w=$(window 7d "$sd_pct" "$sd_reset"); [ -n "$w" ] && seg+=("$w") ;;
    ctx)
      if [ "$ctx" != "-" ]; then
        p=${ctx%%.*}
        seg+=("$(printf '%sctx%s %s%s%%%s' "$DIM" "$RESET" "$(hue "$p")" "$p" "$RESET")")
      fi ;;
    turns)
      read -r t_last t_mean <<<"$(turn_times "$transcript")"
      if [ -n "${t_last:-}" ]; then
        seg+=("$(printf '%s⏱%s %s%s%s %s⌀ %s%s' \
          "$DIM" "$RESET" "$(dur_hue "$t_last")" "$(fmt_dur "$t_last")" "$RESET" \
          "$DIM" "$(fmt_dur "$t_mean")" "$RESET")")
      fi ;;
    model)
      tail_bits="$model"
      [ "$effort" != "-" ] && tail_bits+="·$effort"
      [ "$thinking" != "-" ] && tail_bits+="·think"
      seg+=("$(printf '%s%s%s' "$DIM" "$tail_bits" "$RESET")") ;;
    where)
      loc="$dir"
      [ "$pr" != "-" ] && loc+=" #$pr"
      seg+=("$(printf '%s%s%s' "$DIM" "$loc" "$RESET")") ;;
    # A name nothing answers to is drawn, not dropped: a silently missing
    # segment looks exactly like one whose data was absent this turn.
    *) seg+=("$(printf '%s?%s%s' "$DIM" "$name" "$RESET")") ;;
  esac
done
out=""
for s in "${seg[@]}"; do
  [ -n "$out" ] && out+="$DIM │ $RESET"
  out+="$s"
done
printf '%s\n' "$out"
