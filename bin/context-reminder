#!/usr/bin/env bash
# context-reminder: UserPromptSubmit and PostToolUse hook. Every call re-reads
# the whole context, so remind Claude (and the human) to hand off and cycle:
# after a prompt once a session passes 200k tokens, and after a tool call once
# it passes 150k, since an unattended until-pr run sends no prompts. Never blocks.
set -uo pipefail

input=$(cat)
event=$(jq -r '.hook_event_name // empty' <<<"$input" 2>/dev/null)
transcript=$(jq -r '.transcript_path // empty' <<<"$input" 2>/dev/null)
[ -n "$transcript" ] && [ -r "$transcript" ] || exit 0

tokens=$(
  tac "$transcript" \
    | jq -R 'fromjson? | select(.type == "assistant" and .message.usage != null) | .message.usage
             | (.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)' 2>/dev/null \
    | head -n 1
)
threshold=200000
[ "$event" = PostToolUse ] && threshold=150000
[ -n "$tokens" ] && [ "$tokens" -ge "$threshold" ] 2>/dev/null || exit 0

k=$((tokens / 1000))
if [ "$event" = PostToolUse ]; then
  [ "$("$(dirname "$0")/claude-dev" mode 2>/dev/null)" = until-pr ] || exit 0
  jq -cn --arg k "$k" '{
    systemMessage: ("Context at " + $k + "k tokens: cycling at the next green commit."),
    hookSpecificOutput: {
      hookEventName: "PostToolUse",
      additionalContext: ("This until-pr session is at " + $k + "k tokens of context. At the next green commit, run the handoff skill, then run claude-dev cycle yourself.")
    }
  }'
  exit 0
fi

jq -cn --arg k "$k" '{
  systemMessage: ("Context at " + $k + "k tokens: time to hand off and cycle."),
  hookSpecificOutput: {
    hookEventName: "UserPromptSubmit",
    additionalContext: ("This session is at " + $k + "k tokens of context, and every call re-reads all of it. Finish the current stride, then run the handoff skill and propose claude-dev cycle before starting new work.")
  }
}'
