#!/usr/bin/env bash
# PreToolUse hook: refuse a write into a product main checkout when this task
# window owns a worktree for that repo.
#
# The agent pane's cwd is claude-dev's root: a workspace of repos, or a single
# repo's main checkout. Either way the main checkout is what a half-specified
# path, a bare repo name or a bare git command resolves to. task-context states
# the right target at session start; this refuses the wrong one when that
# notice has faded. Reads are never blocked — probing master is legitimate —
# and neither are git-ignored paths such as the task's handoff.
set -uo pipefail

input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null)
case "$tool" in Bash | Write | Edit | NotebookEdit) ;; *) exit 0 ;; esac

root="${CLAUDE_PROJECT_DIR:-$PWD}"
slug="${CLAUDE_TASK_SLUG-}"
if [ -z "$slug" ] && [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
  slug=$(tmux display-message -p -t "$TMUX_PANE" '#W' 2>/dev/null)
fi
[ -n "$slug" ] && [ "$slug" != hub ] || exit 0

# Only repos where this window owns a worktree: blocking a repo with no
# alternative checkout would leave nowhere to work.
REPOS=() WTS=()
for repo in "$root"/ "$root"/*/; do
  repo="${repo%/}"
  [ -d "$repo/.claude/worktrees/$slug" ] || continue
  REPOS+=("$repo") WTS+=("$repo/.claude/worktrees/$slug")
done
[ "${#REPOS[@]}" -gt 0 ] || exit 0

deny() {
  printf 'Blocked: %s\nUse this task window'"'"'s worktree instead: %s\n%s' "$1" "$2" "${3-}" >&2
  exit 2
}

# The shell expands these into files the guard never sees named.
shell_expands() {
  [[ "$1" == *[\*\?\[\{\$\`~\\]* ]]
}

# Only the repo holding the path decides: a root that ignores a nested repo
# says nothing about that repo's files. The root comes first, so the last
# repo holding the path is the deepest.
ignored() {
  local repo owner=
  ! shell_expands "$1" || return 1
  for repo in "${REPOS[@]}"; do
    case "$1" in "$repo"/*) owner="$repo" ;; esac
  done
  git -C "$owner" check-ignore -q "$1" 2>/dev/null
}

if [ "$tool" != Bash ]; then
  file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
  [ -n "$file" ] || exit 0
  for i in "${!REPOS[@]}"; do
    case "$file" in
      "${REPOS[i]}"/.claude/worktrees/*) exit 0 ;;
      "${REPOS[i]}"/*) ignored "$file" && exit 0
        deny "$file is in the main checkout of $(basename "${REPOS[i]}")." \
        "${WTS[i]}/${file#"${REPOS[i]}"/}" ;;
    esac
  done
  exit 0
fi

# A segment pointing a path at a protected repo, or running under a cwd inside
# one, is aimed at the main checkout. Only mutating segments are refused.
#
# The repo name has to sit at the head of a token to count. It shows up in
# plenty of things that are not paths — `--repo acme/acme-backend`, a
# commit message, the replacement half of a sed script — and treating those as
# writes refuses commands that never touch the checkout.
targets_main() {
  local seg="$1" repo name tok
  local -a toks
  IFS=$' \t' read -ra toks <<<"$seg"
  for tok in "${toks[@]}"; do
    tok="${tok//[\"\']/}"
    tok="${tok#*=}"
    tok="${tok#./}"
    tok="${tok/#\~/$HOME}"
    for repo in "${REPOS[@]}"; do
      case "$tok" in "$repo" | "$repo"/*) [ -n "${2-}" ] && ignored "$tok" || return 0 ;; esac
      # The root's own name heads no path written from the root, and other
      # repos share it when it is a common one such as .claude.
      [ "$repo" = "$root" ] && continue
      name=$(basename "$repo")
      # Written as a path from the workspace root: the bare repo name heads it.
      case "$tok" in "$name" | "$name"/*) return 0 ;; esac
      # Rooted in a variable the guard cannot resolve, so the name may sit
      # deeper in the path. A bare word with a slash in it is as likely to be
      # `acme/acme-backend`, which addresses GitHub.
      case "$tok" in \$*/"$name" | \$*/"$name"/*) return 0 ;; esac
    done
  done
  return 1
}

# A quoted word may hold spaces: it stays open until its quote closes.
in_quote() {
  local s="$1" q= i c
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    [ -n "$q" ] && { [ "$c" != "$q" ] || q=; continue; }
    [[ "$c" == [\"\'] ]] && q="$c"
  done
  [ -n "$q" ]
}

# sed -i edits only files that already exist, so the tokens naming one under
# the cd target, or the pane's cwd without one, are the files it writes.
# Nothing found there means the target could not be resolved, and the write
# is refused.
edits_only_ignored() {
  local tok word= path seen=0 base="$cwd"
  local -a toks
  [ "$in_main" = 0 ] || base="$target"
  IFS=$' \t' read -ra toks <<<"$1"
  for tok in "${toks[@]}"; do
    word="${word:+$word }$tok"
    in_quote "$word" && continue
    tok="$word" word=
    [[ "$tok" =~ ^\'[^\']*\'$ ]] || ! shell_expands "$tok" || return 1
    tok="${tok//[\"\']/}"
    # A backup suffix writes <file><suffix>, which the ignore rule need not cover.
    [[ "$tok" =~ ^-[^-]*i. || "$tok" == --i*=* ]] && return 1
    case "$tok" in /*) path="$tok" ;; *) path="$base/$tok" ;; esac
    [ -e "$path" ] || continue
    ignored "$path" || return 1
    seen=1
  done
  [ -z "$word" ] && [ "$seen" = 1 ]
}

git_mutates() {
  [[ "$1" =~ ^[[:space:]]*git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+(checkout|switch)[[:space:]]+(main|master)[[:space:]]*$ ]] && return 1
  [[ "$1" =~ (^|[[:space:]])git([[:space:]]|$) ]] &&
    [[ "$1" =~ (^|[[:space:]])(commit|add|checkout|switch|merge|rebase|reset|revert|push|stash|cherry-pick|apply|restore|clean)([[:space:]]|$) ]]
}

mutates() {
  local seg="$1"
  git_mutates "$seg" && return 0
  [[ "$seg" =~ (^|[[:space:]])sed[[:space:]](.*[[:space:]])?[\"\']?(-[^-[:space:]]*i|--i) ]] &&
    ! edits_only_ignored "$seg" && return 0
  # For a copy only the destination is a write: reading a file out of the
  # main checkout is legitimate. A move also deletes its source.
  if [[ "$seg" =~ (^|[[:space:]])(cp|ln|install)([[:space:]]|$) ]]; then
    { [ "$in_main" = 1 ] || targets_main "${seg##* }" writes; } && return 0
    return 1
  fi
  [[ "$seg" =~ (^|[[:space:]])(rm|mv|mkdir|touch|chmod|tee|truncate|dd)([[:space:]]|$) ]] &&
    { [ "$in_main" = 1 ] || targets_main "$seg" writes; } && return 0
  # A redirect is a write, but only where it lands. An absolute destination
  # says for itself whether it is in the checkout; a relative one resolves
  # against a cwd this segment has already been judged to be main, so it is
  # judged by the file it names under the cd target.
  local rest="$seg" dest
  while [[ "$rest" =~ \>\>?[[:space:]]*([^[:space:]\|\&\;]+)(.*) ]]; do
    dest="${BASH_REMATCH[1]}" rest="${BASH_REMATCH[2]}"
    case "$dest" in
      /*) targets_main "$dest" writes && return 0 ;;
      *) [ "$in_main" = 1 ] && ignored "$target/$dest" || return 0 ;;
    esac
  done
  return 1
}

cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)
[ -n "$cmd" ] || exit 0
in_main=0
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
cwd_main=0
for repo in "${REPOS[@]}"; do
  case "$cwd/" in "$repo"/.claude/worktrees/*) ;; "$repo"/*) cwd_main=1 ;; esac
done
while IFS= read -r seg || [ -n "$seg" ]; do
  [ -n "${seg//[[:space:]]/}" ] || continue

  if [[ "$seg" =~ ^[[:space:]]*cd[[:space:]]+([^[:space:]]+) ]]; then
    target="${BASH_REMATCH[1]//[\"\']/}"
    target="${target/#\~/$HOME}"
    in_main=0
    case "$target" in /* | \$* | *.claude/worktrees/*) cwd_main=0 ;; esac
    case "$target" in */.claude/worktrees/*) continue ;; esac
    targets_main "$target" && in_main=1
    case "$target" in /*) ;; *) target="$root/$target" ;; esac
    continue
  fi

  case "$seg" in *"/.claude/worktrees/$slug"*) continue ;; esac
  # Cutting another task's worktree where the conventions put it writes git's
  # worktree metadata, never the main checkout's files.
  [[ "$seg" =~ (^|[[:space:]])worktree[[:space:]]+add[[:space:]](.*[[:space:]])?([^[:space:]]*/)?\.claude/worktrees/ ]] && continue
  [ "$cwd_main" = 1 ] && [[ "$seg" =~ ^[[:space:]]*git[[:space:]] ]] && ! [[ "$seg" =~ ^[[:space:]]*git[[:space:]]+-C[[:space:]] ]] && git_mutates "$seg" &&
    deny "\`$(printf '%s' "$seg" | sed 's/^[[:space:]]*//')\` runs git in a main checkout." "${WTS[0]}"
  { [ "$in_main" = 1 ] || targets_main "$seg"; } || continue
  mutates "$seg" && deny "\`$(printf '%s' "$seg" | sed 's/^[[:space:]]*//')\` writes to a main checkout." "${WTS[0]}" \
    $'Git-ignored files there (plans, handoffs) stay writable: use Edit/Write or their absolute path.\n'
done < <(printf '%s' "$cmd" | awk '
  d != "" { if ($0 == d) { d = ""; held = "" } else held = held $0 "\n"; next }
  { print }
  match($0, /<<["\047]?[A-Za-z_][A-Za-z0-9_]*/) &&
    $0 !~ /(^|[^A-Za-z0-9_.\/-])(bash|sh|zsh)([^A-Za-z0-9_.\/-]|$)/ {
    d = substr($0, RSTART, RLENGTH); sub(/^<<["\047]?/, "", d)
  }
  END { printf "%s", held }' | sed -e 's/&&/\n/g' -e 's/||/\n/g' -e 's/;/\n/g' -e 's/|/\n/g')
exit 0
