#!/usr/bin/env bash
# install: wire this checkout into the machine it was cloned onto.
#
#   bin/install                          report every per-machine fact and
#                                        wire the ones not wired yet
#
# Idempotent by contract: it is run once on a fresh machine and again on one
# already set up, so it states what it finds before changing anything, and
# changes only what is missing. `claude-dev doctor` does this for a workspace;
# this does it for the machine. Nothing already on the machine is replaced.
set -euo pipefail

ROOT="${CLAUDE_CONFIG_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

# The tools invoked by name — from a shell, from the tmux bindings, from
# Claude. statusline is not among them: settings.json names it by absolute
# path. Neither is preflight, which is run as bin/preflight in the checkout.
TOOLS=(claude-dev claude-dev-review claude-dev-status)

# One line per fact: a dim glyph, the thing, what is true of it.
line()  { printf '  \033[2m%s\033[0m %-18s %s\n' "$1" "$2" "$3"; }
ok()    { line ✓ "$1" "$2"; }
wired() { line → "$1" "$2"; }
warn()  { line ! "$1" "$2"; }

# The repo is public and .githooks/pre-commit refuses any commit carrying a
# client name, a credential or a personal path — but only once core.hooksPath
# points at it. git does not adopt a repo's hooks on its own.
commit_guard() {
  local current
  current=$(git -C "$ROOT" config --local core.hooksPath || true)
  if [ "$current" = .githooks ]; then
    ok 'commit guard' 'already wired to .githooks'
    return
  fi
  git -C "$ROOT" config --local core.hooksPath .githooks
  wired 'commit guard' 'core.hooksPath now .githooks'
}

# Put one file in place without replacing what is already there. A link counts
# as ours only when it resolves to the file we mean to install: accepting one
# by its name would report a wired machine that runs an older checkout's copy.
# Answers 1 when the name was taken, so a caller can say what to do instead.
link_file() { # target link label
  if [ -L "$2" ] && [ "$(readlink -f "$2")" = "$(readlink -f "$1")" ]; then
    ok "$3" 'already linked'
  elif [ -e "$2" ] || [ -L "$2" ]; then
    warn "$3" 'not ours — left alone'
    return 1
  else
    ln -s "$1" "$2"
    wired "$3" 'linked'
  fi
}

tools_on_path() {
  local dir="$HOME/.local/bin" t
  mkdir -p "$dir"
  printf 'bin dir:  %s\n' "$dir"
  for t in "${TOOLS[@]}"; do
    link_file "$ROOT/bin/$t" "$dir/$t" "$t" || true
  done
}

# Everything the workspace does with tmux — the prefix, the review popup, the
# serve button, the window tabs — lives in dotfiles/tmux.conf, and none of it
# exists until ~/.tmux.conf points at it. tmux says nothing about a config it
# was never told about, so an unlinked machine just has no bindings.
tmux_config() {
  local target="$ROOT/dotfiles/tmux.conf"
  printf 'home:     %s\n' "$HOME"
  link_file "$target" "$HOME/.tmux.conf" 'tmux.conf' ||
    printf '    add ours on top of it:  source %s\n' "$target"
}

# settings.json turns some skills off. That is a preference, not a wiring
# fault, so this states it rather than counting it against the machine — but
# it does state it, because nothing else announces that a skill will not load.
skills_off() {
  local settings="$ROOT/settings.json" off
  printf 'settings: %s\n' "$settings"
  if [ ! -f "$settings" ]; then
    warn 'skills' 'no settings.json in this checkout'
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    warn 'skills' 'cannot read them — jq is not installed'
    return 0
  fi
  off=$(jq -r '(.skillOverrides // {}) | to_entries
    | map(select(.value == "off") | .key) | join(" ")' "$settings")
  ok 'skills off' "${off:-none}"
}

printf 'checkout: %s\n' "$ROOT"
commit_guard
tools_on_path
tmux_config
skills_off
